# Bu dosyayı ".env.local" olarak kopyala ve anahtarlarını yaz.
# .env.local git'e yüklenmez ve UYGULAMANIN İÇİNE GİRMEZ —
# sadece derleme öncesi çalıştırdığın üretim scriptleri okur.

# ElevenLabs — ses dosyalarını bir kez üretmek için
ELEVENLABS_API_KEY=
# "npm run gen:audio -- --list" komutuyla ses id'lerini görebilirsin
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_EN=
# İsteğe bağlı: varsayılan eleven_multilingual_v2
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Anthropic — ek ders/alıştırma üretmek için
ANTHROPIC_API_KEY=
